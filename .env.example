# ==============================================================================
# Upwork Monitor - Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# Telegram Bot Token (obtained from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=1234567890:ABCDefghIJKlmNoPQRstuVWXyz

# Telegram Chat or Channel ID where job alerts will be sent
# For private chats: your numeric user ID from @userinfobot (e.g. 123456789)
# For private channels or groups: channel ID (e.g. -100xxxxxxxxxx)
TELEGRAM_CHANNEL=123456789

# Target Tech Stack & Search Keywords (comma-separated, auto-generates recency queries)
# Leave empty to use the default search URLs in settings.py
SEARCH_KEYWORDS=Python, React, Node.js, FastAPI, TypeScript

# Optional: Full custom Upwork search URLs (comma-separated, overrides SEARCH_KEYWORDS)
# SEARCH_URLS=https://www.upwork.com/nx/search/jobs/?q=Python&sort=recency,https://www.upwork.com/nx/search/jobs/?q=React&sort=recency

# Maximum job age in minutes (only alert for jobs posted under this duration, default: 60)
MAX_JOB_AGE_MINUTES=60

# Minimum fixed-price budget in USD (jobs below this budget are skipped, default: 50)
MIN_FIXED_BUDGET=50

# Polling interval in seconds when using loop_monitor.py or start.sh (default: 180 = 3 minutes)
CHECK_INTERVAL_SECONDS=180
